# Copy this file to keystore.properties (same folder) and fill in your values.
# keystore.properties is gitignored — it must NEVER be committed.
#
# storeFile   absolute path to your upload keystore (.jks)
# storePassword / keyPassword  the passwords you set when creating the keystore
# keyAlias    the alias you named the key (shown in the "Generate Signed Bundle" wizard)

storeFile=/Users/austinpuckett/setout-upload.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
